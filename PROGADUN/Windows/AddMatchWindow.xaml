<Window x:Class="PROGADUN.Windows.AddMatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PROGADUN.Windows"
        mc:Ignorable="d"
        Title="Новое мероприятие" Height="512" Width="820" ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64*"/>
            <RowDefinition Height="56*"/>
            <RowDefinition Height="28*"/>
            <RowDefinition Height="49*"/>
            <RowDefinition Height="14*"/>
            <RowDefinition Height="49*"/>
            <RowDefinition Height="15*"/>
            <RowDefinition Height="49*"/>
            <RowDefinition Height="15*"/>
            <RowDefinition Height="49*"/>
            <RowDefinition Height="12*"/>
            <RowDefinition Height="53*"/>
            <RowDefinition Height="10*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="125*"/>
            <ColumnDefinition Width="464*"/>
            <ColumnDefinition Width="125*"/>
        </Grid.ColumnDefinitions>
        <Grid.Background>
            <ImageBrush ImageSource="/PROGADUN;component/Image/FON.png"/>
        </Grid.Background>
        <Label Content="Мероприятие" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="32" FontWeight="Bold" />
        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
            <Label Content="Название:" VerticalAlignment="Center" FontSize="20"/>
            <Separator Width="10" Opacity="0"/>
            <TextBox Name="NameTb" Width="310" Background="{x:Null}" BorderBrush="Black" BorderThickness="2" Height="30"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal">
            <Separator Width="42" Opacity="0"/>
            <Label Content="Гости:" VerticalAlignment="Center" FontSize="20"/>
            <Separator Width="5" Opacity="0"/>
            <TextBox Name="GuestTb" Width="310" Background="{x:Null}" BorderBrush="Black" BorderThickness="2" Height="30"/>
        </StackPanel>

        <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal">
            <Label Content="Дата проведения:" VerticalAlignment="Center" FontSize="20"/>
            <Separator Width="0" Opacity="0"/>
            <DatePicker Width="150" Height="25" Name="DateDP"/>
        </StackPanel>

        <StackPanel Grid.Row="9" Grid.Column="1" Orientation="Horizontal">
            <Separator Width="42" Opacity="0"/>
            <Label Content="Арена:" VerticalAlignment="Center" FontSize="20"/>
            <Separator Width="0" Opacity="0"/>
            <ComboBox Name="ArenaCmb" Width="310" Background="{x:Null}" BorderBrush="Black" BorderThickness="2" Height="30"/>
        </StackPanel>
        <Button Grid.Row="11" Grid.Column="1" Content="ОТПРАВИТЬ" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="5" Click="Button_Click"/>
    </Grid>
</Window>
