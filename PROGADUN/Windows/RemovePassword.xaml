<Window x:Class="PROGADUN.Windows.RemovePassword"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PROGADUN.Windows"
        mc:Ignorable="d" WindowStartupLocation="CenterScreen"
        Title="RemovePassword" Height="1024" Width="1440">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="306*"/>
            <RowDefinition Height="532*"/>
            <RowDefinition Height="155*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="89*"/>
            <ColumnDefinition Width="777*"/>
            <ColumnDefinition Width="566*"/>
        </Grid.ColumnDefinitions>
        <Grid.Background>
            <ImageBrush ImageSource="/PROGADUN;component/Image/Desktop1.png"/>
        </Grid.Background>
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="46*"/>
                <RowDefinition Height="35*"/>

                <RowDefinition Height="39*"/>
                <RowDefinition Height="186*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="111*"/>
                <ColumnDefinition Width="408*"/>
                <ColumnDefinition Width="47*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="+ 7 (925) 326 - 30 - 21" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="16" TextDecorations="Underline"/>
            <TextBlock Text="Tелефон горячей линии" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="16" TextDecorations="Underline"/>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="240*"/>
                <RowDefinition Height="52*"/>
                <RowDefinition Height="240*"/>
            </Grid.RowDefinitions>
            <Image Source="/Image/PredstoyashieMatch.png" />
            <Image Grid.Row="2" Source="/Image/ENDMATCH.png" />
        </Grid>

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="59*"/>
                <RowDefinition Height="42*"/>
                <RowDefinition Height="22*"/>
                <RowDefinition Height="24*"/>
                <RowDefinition Height="54*"/>
                <RowDefinition Height="19*"/>
                <RowDefinition Height="22*"/>
                <RowDefinition Height="54*"/>
                <RowDefinition Height="16*"/>
                <RowDefinition Height="19*"/>
                <RowDefinition Height="54*"/>
                <RowDefinition Height="39*"/>
                <RowDefinition Height="72*"/>
                <RowDefinition Height="36*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="28*"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="ВОССТАНОВЛЕНИЕ ПАРОЛЯ" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="32" Height="44" Margin="84,58,84,21" Grid.RowSpan="3" Width="420" />
            <TextBlock Text="Логин" Grid.Row="3" Grid.Column="1" VerticalAlignment="Bottom" FontSize="16" Height="21"/>
            <Border CornerRadius="20" Background="White" Padding="5" Grid.Row="4" Grid.Column="1" BorderBrush="Black" BorderThickness="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0*"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <!-- Текстовое поле -->
                    <TextBox x:Name="LoginTB" FontSize="28" Background="White"
                 HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                 BorderThickness="0"  Grid.ColumnSpan="2" Foreground="Black"/>
                </Grid>
            </Border>

            <TextBlock Text="Новый пароль" Grid.Row="6" Grid.Column="1" VerticalAlignment="Bottom" FontSize="16" Height="21"/>
            <Border CornerRadius="20" Background="White" Padding="5" Grid.Row="7" Grid.Column="1" BorderBrush="Black" BorderThickness="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0*"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <!-- Текстовое поле -->
                    <PasswordBox x:Name="NewPasswordPB" FontSize="28" Background="White"
                 HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                 BorderThickness="0"  Grid.ColumnSpan="2" Foreground="Black" PasswordChar="*"/>
                </Grid>
            </Border>
            <TextBlock Text="Повторите пароль" Grid.Row="9" Grid.Column="1" VerticalAlignment="Bottom" FontSize="16" Height="21"/>
            <Border CornerRadius="20" Background="White" Padding="5" Grid.Row="10" Grid.Column="1" BorderBrush="Black" BorderThickness="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0*"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <!-- Текстовое поле -->
                    <PasswordBox x:Name="RepeatPasswordPB" FontSize="28" Background="White"
                 HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                 BorderThickness="0"  Grid.ColumnSpan="2" Foreground="Black" PasswordChar="*"/>
                </Grid>
            </Border>

            <Button Content="СОХРАНИТЬ" Background="Black" Foreground="White" 
                    FontSize="40"  Grid.Column="1" Grid.Row="12"  HorizontalAlignment="Center" VerticalAlignment="Center" Width="250" Margin="169,10" Height="52" Click="Button_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Black" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Grid>
</Window>
