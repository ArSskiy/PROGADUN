<Page x:Class="PROGADUN.Pages.PoluZashita2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PROGADUN.Pages"
      mc:Ignorable="d" 
     d:DesignHeight="480" d:DesignWidth="650"
      Title="PoluZashita2">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="321*"/>
            <ColumnDefinition Width="8*"/>
            <ColumnDefinition Width="321*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="28*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="129*"/>
        </Grid.RowDefinitions>
        <TextBox Grid.Row="1" Grid.ColumnSpan="3" Background="Black"/>
        <TextBox Grid.Column="1" Grid.RowSpan="3" Background="Black"/>
        <TextBlock Text="ФОТОГРАФИЯ ИГРОКА" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <TextBlock Text="ИНФОРМАЦИЯ" Grid.Column="2" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Image Source="/Image/poluzashit2.png" Grid.Row="2"/>
        <Grid Grid.Row="2" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="27*"/>
                <RowDefinition Height="36*"/>
                <RowDefinition Height="37*"/>
                <RowDefinition Height="35*"/>
                <RowDefinition Height="68*"/>
                <RowDefinition Height="28*"/>
                <RowDefinition Height="52*"/>
                <RowDefinition Height="35*"/>
                <RowDefinition Height="12*"/>
                <RowDefinition Height="46*"/>
                <RowDefinition Height="11*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="11*"/>
                <ColumnDefinition Width="310*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Grid.Row="1" Text="ВОЗРАСТ: 18" FontSize="20" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Grid.Row="3" Text="ДАТА РОЖДЕНИЯ: 14.04.2006" FontSize="20" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Grid.Row="5" Text="ПОЗИЦИЯ: ПОЛУ-ЗАЩИТНИК" FontSize="20" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Grid.Row="7" Text="ФИО: МЕЛЬНИКОВ ЕЛИСЕЙ" FontSize="20" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <Button Content="ПОДАТЬ ЗАЯВКУ" Background="#D9D9D9" Foreground="Black" 
                    FontSize="20"  Grid.Column="1" Grid.Row="9"  HorizontalAlignment="Center" VerticalAlignment="Center" Width="200" Height="40" >
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#D9D9D9" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

    </Grid>
</Page>
